---
import Base from '../../layouts/Base.astro';import Card from '../../components/Card.astro';import {articles,summary,safeJSON} from '../../lib/content';import {getRelatedArticles,getResourceLinks,estimateDifficulty,estimateCost} from '../../../../web/lib/articleInsights';
export function getStaticPaths(){return articles.map(article=>({params:{id:article.id},props:{article}}));}
const {article:a}=Astro.props;const resources=getResourceLinks(a);const related=getRelatedArticles(a,articles,3);const jsonld={'@context':'https://schema.org','@type':'Article',headline:a.title,description:summary(a),datePublished:a.publishedAt,mainEntityOfPage:new URL('/article/'+a.id,Astro.site).href};
---
<Base title={a.title} description={summary(a)}><script slot="head" type="application/ld+json" set:html={safeJSON(jsonld)}/><article data-pagefind-body data-pagefind-filter={'category:'+a.category}><div class="meta"><a href={'/category/'+a.category}>{a.category}</a><span data-pagefind-filter="source">{a.source}</span><time datetime={a.publishedAt}>{a.publishedAt}</time></div><h1 data-pagefind-meta="title">{a.title}</h1><p class="lead" data-pagefind-meta="description">{summary(a)}</p><p data-pagefind-ignore class="authors">{(a.authors||[]).join(' / ')}</p><div data-pagefind-ignore class="actions"><a class="primary" href={a.url} target="_blank" rel="noopener noreferrer" data-external data-kind="source" data-article-id={a.id}>原典を読む ↗</a><button data-bookmark data-id={a.id} data-title={a.title} data-path={'/article/'+a.id} data-source={a.source} aria-pressed="false">保存</button></div><dl data-pagefind-ignore class="facts"><div><dt>用途</dt><dd>{a.use_case||'原典で確認'}</dd></div><div><dt>難易度の目安</dt><dd>{estimateDifficulty(a).level}</dd></div><div><dt>実装コストの目安</dt><dd>{estimateCost(a).level}</dd></div></dl><section data-pagefind-ignore><h2>概要</h2><p class="abstract">{a.abstract_ja||a.abstract||a.summary}</p></section><section data-pagefind-ignore><h2>参考リンク</h2><ul>{resources.map(r=><li><a href={r.url} target="_blank" rel="noopener noreferrer" data-external data-kind={r.kind} data-article-id={a.id}>{r.label} ↗</a></li>)}</ul><p class="muted">リンク先のライセンス・再現性・データ条件をご確認ください。自動分類や実装の目安は保証ではありません。</p></section><section data-pagefind-ignore><h2>実装を始めるプロンプト</h2><p>参考リンクを確認したうえで、次の内容をコピーして利用できます。</p><pre id="implementation-prompt">{`# 論文・記事\n${a.title}\n\n# 概要\n${summary(a)}\n\n# 原典\n${a.url}\n\n上記の手法を実装してください。実行前に依存関係とライセンスを確認してください。`}</pre><button data-copy-prompt>プロンプトをコピー</button><span id="copy-status" role="status"></span></section></article><section><h2>関連する記事</h2><div class="grid">{related.map(r=><Card article={r}/>)}</div></section></Base>
