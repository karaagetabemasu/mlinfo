---
import Base from '../layouts/Base.astro';import Card from '../components/Card.astro';import {articles,categories,updated} from '../lib/content';import {manufacturingGuides} from '../../../web/lib/manufacturingCatalog';
---
<Base><section class="hero"><p class="eyebrow">MANUFACTURING AI / MATERIALS INFORMATICS</p><h1>製造業・材料開発のための<br/>AI内製化ナビ</h1><p>自社のExcel・CSVデータで試すための、論文・実装・最初の一歩。</p><span class="muted">{articles.length} articles · 更新 {updated.slice(0,10)}</span></section><section><h2>あなたの課題はどれ？</h2><div class="grid guides">{manufacturingGuides.map(g=><a class="guide" href={'/manufacturing-ai/'+g.slug}><h3>{g.shortTitle}</h3><p>{g.problem}</p><small>{g.baseline}から始める →</small></a>)}</div></section><section><h2>カテゴリから探す</h2><div class="categories">{categories.map(c=><a href={'/category/'+c.id}>{c.name} <span>{articles.filter(a=>a.category===c.id).length}</span></a>)}</div></section><section><div class="heading"><h2>新着・実装判断カード</h2><a href="/weekly">すべて見る →</a></div><div class="grid">{articles.slice(0,24).map(a=><Card article={a}/>)}</div></section></Base>
