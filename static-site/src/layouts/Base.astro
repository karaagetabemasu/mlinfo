---
import '../styles.css';
const {title='製造業・材料開発のためのAI/MI内製化ナビ',description='公開論文・実装・手順から、製造業と材料開発のAI活用を考える。',noindex=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site).href;
---
<!doctype html><html lang="ja"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | MLinfo</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>{noindex&&<meta name="robots" content="noindex,follow"/>}<slot name="head"/></head><body><a class="skip" href="#main">本文へ</a><header><a class="logo" href="/">MLinfo<span>AI / MI NAVIGATOR</span></a><nav aria-label="メイン"><a href="/manufacturing-ai">製造業AI</a><a href="/topics">トピック</a><a href="/weekly">新着</a><a href="/compare">比較</a><a href="/saved">保存</a></nav><form action="/search" method="get" role="search"><input name="q" aria-label="記事を検索" placeholder="論文・記事を検索…" maxlength="200"/><button>検索</button></form></header><main id="main"><slot/></main><footer><a href="/">MLinfo</a><a href="/privacy">プライバシー</a><a href="/feed.xml">RSS</a><button data-consent-settings>解析設定</button><span>公開情報をもとにした技術紹介。採用前に原典・実装・利用条件をご確認ください。</span></footer><aside id="consent" class="consent" hidden><p>利用状況の改善にGoogle Analyticsを使用します。許可するまで解析スクリプトを読み込みません。</p><button data-consent="yes">許可する</button><button data-consent="no">許可しない</button></aside><script src="../scripts/site.ts"></script></body></html>
